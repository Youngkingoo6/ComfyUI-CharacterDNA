{
  "CharacterDNADesigner": {
    "display_name": "🧬 角色 DNA 设计器",
    "description": "建立角色的基础身份资料，不在此阶段随机生成面部结构。",
    "inputs": {
      "character_name": {
        "name": "角色名称",
        "tooltip": "用于身份记录的稳定名称。"
      },
      "gender": {
        "name": "性别",
        "tooltip": "写入基础身份提示词的性别表达。"
      },
      "ancestry": {
        "name": "族裔",
        "tooltip": "写入基础身份提示词的外观族裔表达。"
      },
      "visual_age": {
        "name": "视觉年龄",
        "tooltip": "角色呈现出来的年龄，范围 0–120。"
      },
      "identity_appearance": {
        "name": "外观辨识特征",
        "tooltip": "由所有身份提示词继承、用于增强角色辨识度的瞳色、肤色、发型及标记。"
      }
    },
    "outputs": {
      "0": {
        "name": "角色 DNA"
      }
    }
  },
  "CharacterDNAParametricDesigner": {
    "display_name": "🧬 参数化面部设计器",
    "description": "覆盖一个面部 Feature，并继承输入 DNA 中所有其他面部参数；修改多项时可串联多个节点。",
    "inputs": {
      "character_dna": {
        "name": "角色 DNA"
      },
      "feature": {
        "name": "面部特征",
        "tooltip": "选择要覆盖的单个面部结构特征。",
        "options": {
          "cheekbone_height": "颧骨高度",
          "cheekbone_projection": "颧骨立体度",
          "jawline_definition": "下颌线清晰度",
          "eyebrow_shape": "眉形",
          "eyebrow_thickness": "眉毛粗细",
          "face_length": "脸长",
          "face_width": "脸宽",
          "cheekbone_width": "颧骨宽度",
          "jaw_width": "下颌宽度",
          "chin_width": "下巴宽度",
          "chin_length": "下巴长度",
          "eye_elongation": "眼型",
          "eye_openness": "眼睛大小",
          "eye_spacing": "眼距",
          "canthal_tilt": "眼尾倾斜",
          "brow_eye_distance": "眉眼距离",
          "nose_width": "鼻子宽度",
          "nose_length": "鼻子长度",
          "nose_projection": "鼻梁立体度",
          "nose_tip_rotation": "鼻尖方向",
          "mouth_width": "嘴巴宽度",
          "upper_lip_fullness": "上唇厚度",
          "lower_lip_fullness": "下唇厚度",
          "cupid_bow_definition": "唇峰清晰度"
        }
      },
      "value": {
        "name": "参数值",
        "tooltip": "从 -1、-0.5、0、0.5、1 五档中选择；0 为中性基线。"
      },
      "weight": {
        "name": "提示词权重",
        "tooltip": "0 保持原提示词不加权；选择 1.0–2.0，步进 0.1，输出格式为（特征词:权重）。"
      }
    },
    "outputs": {
      "0": {
        "name": "角色 DNA"
      },
      "1": {
        "name": "英文面部提示词"
      },
      "2": {
        "name": "中文面部提示词"
      }
    }
  },
  "CharacterDNASeedGenerator": {
    "display_name": "🧬 面部 DNA 种子生成器",
    "description": "根据 seed、独特度和协调度，确定性生成 24 维面部结构参数。",
    "inputs": {
      "character_dna": {
        "name": "角色 DNA"
      },
      "seed": {
        "name": "面部种子",
        "tooltip": "决定 24 个面部 Feature 的方向与组合；相同输入得到相同面部 DNA。"
      },
      "distinctiveness": {
        "name": "独特度",
        "tooltip": "控制面部偏离中性基线的强度和主要身份特征数量；越高越鲜明。"
      },
      "harmony": {
        "name": "协调度",
        "tooltip": "控制对冲突、极端面部组合的柔化程度；越高越协调稳定。"
      }
    },
    "outputs": {
      "0": {
        "name": "角色 DNA"
      },
      "1": {
        "name": "英文面部提示词"
      },
      "2": {
        "name": "面部参数 JSON"
      },
      "3": {
        "name": "中文面部提示词"
      }
    }
  },
  "CharacterDNABodySeedGenerator": {
    "display_name": "🧬 身体 DNA 种子生成器",
    "description": "确定性生成 20 维稳定身体比例参数，并输出继承面部/基础身份后的完整提示词。",
    "inputs": {
      "character_dna": {
        "name": "角色 DNA"
      },
      "body_seed": {
        "name": "身体种子",
        "tooltip": "相同输入会复现相同的身体 DNA。"
      },
      "distinctiveness": {
        "name": "独特度",
        "tooltip": "控制身体比例偏离中性基线的强度。"
      },
      "harmony": {
        "name": "协调度",
        "tooltip": "柔化冲突或不自然的极端组合。"
      },
      "body_profile": {
        "name": "身体组合",
        "tooltip": "seeded 按种子生成；也可直接选择均衡、娇小、运动、曲线或修长高挑组合预设。"
      }
    },
    "outputs": {
      "0": {
        "name": "角色 DNA"
      },
      "1": {
        "name": "英文完整身份提示词"
      },
      "2": {
        "name": "身体参数 JSON"
      },
      "3": {
        "name": "中文完整身份提示词"
      }
    }
  },
  "CharacterDNAParametricBodyDesigner": {
    "display_name": "🧬 参数化身体设计器",
    "description": "覆盖一个身体 Feature，继承面部/基础身份及其他身体参数，并输出完整身份提示词；修改多项时可串联多个节点。",
    "inputs": {
      "character_dna": {
        "name": "角色 DNA"
      },
      "feature": {
        "name": "身体特征",
        "options": {
          "stature": "身高体量",
          "shoulder_width": "肩宽",
          "shoulder_slope": "肩部斜度",
          "ribcage_width": "胸廓宽度",
          "pelvis_width": "骨盆宽度",
          "neck_length": "颈部长度",
          "neck_thickness": "颈部粗细",
          "torso_length": "躯干长度",
          "chest_fullness": "胸部饱满度",
          "waist_definition": "腰线明显度",
          "hip_fullness": "臀胯饱满度",
          "arm_length": "手臂长度",
          "hand_scale": "手部尺度",
          "leg_length": "腿部长度",
          "thigh_length_ratio": "大腿长度比例",
          "foot_scale": "足部尺度",
          "upper_body_fullness": "上身体量",
          "lower_body_fullness": "下身体量",
          "limb_thickness": "四肢粗细",
          "muscularity": "肌肉感"
        }
      },
      "value": {
        "name": "参数值",
        "tooltip": "从 -1、-0.5、0、0.5、1 五档中选择；0 为中性且不输出身体词条。"
      },
      "weight": {
        "name": "提示词权重",
        "tooltip": "0 保持原提示词不加权；1.0–2.0 按 0.1 步进，输出格式为（特征词:权重）。"
      }
    },
    "outputs": {
      "0": {
        "name": "角色 DNA"
      },
      "1": {
        "name": "英文完整身份提示词"
      },
      "2": {
        "name": "中文完整身份提示词"
      }
    }
  },
  "CharacterDNAVisualBlueprint": {
    "display_name": "🧬 角色画面蓝图",
    "description": "为完整 DNA 身份提示词应用一套可复用的画面蓝图，并按种子稳定选择细节变化。穿搭、表情跟姿态、场景和摄影图层在词库面板中编辑。",
    "inputs": {
      "character_dna": {
        "name": "角色 DNA"
      },
      "blueprint": {
        "name": "画面蓝图"
      },
      "variant_seed": {
        "name": "变化种子"
      }
    },
    "outputs": {
      "0": {
        "name": "角色 DNA"
      },
      "1": {
        "name": "英文完整提示词"
      },
      "2": {
        "name": "中文完整提示词"
      },
      "3": {
        "name": "英文负向提示词"
      },
      "4": {
        "name": "中文负向提示词"
      }
    }
  },
  "CharacterDNAInsightFace106Detector": {
    "display_name": "🧬 InsightFace 106 点检测器",
    "description": "检测 InsightFace 106 点并输出五官比例诊断图。",
    "outputs": {
      "0": {
        "name": "106 点坐标"
      },
      "1": {
        "name": "检测信息"
      },
      "2": {
        "name": "诊断图"
      }
    }
  },
  "CharacterDNAPhenotypeGeometry": {
    "display_name": "🧬 表型几何"
  },
  "CharacterDNABatchPhenotypeAnalyzer": {
    "display_name": "🧬 批量表型分析器"
  },
  "CharacterDNALoadCastingDataset": {
    "display_name": "🧬 加载选角数据集"
  },
  "CharacterDNADirectionalCandidateSelector": {
    "display_name": "🧬 定向候选筛选器",
    "description": "使用可编辑目标比例与批内方向共同排序，并直接返回前 N 名和 Pareto 图片批次。",
    "inputs": {
      "character_dna": {
        "name": "角色 DNA"
      },
      "phenotype_dataset": {
        "name": "表型数据集"
      },
      "images": {
        "name": "已分析图片批次"
      },
      "minimum_dna_magnitude": {
        "name": "最小 DNA 强度"
      },
      "top_n": {
        "name": "前 N 名"
      }
    },
    "outputs": {
      "0": {
        "name": "筛选 JSON"
      },
      "1": {
        "name": "摘要"
      },
      "2": {
        "name": "前 N 名图片"
      },
      "3": {
        "name": "Pareto 图片"
      }
    }
  }
}
